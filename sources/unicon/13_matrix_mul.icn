# task 13 matrix_mul — expected output: 599995000
# build: unicon -s 13_matrix_mul.icn    run: 13_matrix_mul.exe
# The plain triple loop, flat 500x500 matrices, no reordering and no blocking.
# timing: &time is Unicon's wall clock in milliseconds since midnight, and &errout is
#         the standard error stream, so TIME_MS goes to stderr and stdout is unchanged.

procedure main()
    ssT0 := &time
    n := 500
    size := n * n
    a := list(size); b := list(size); c := list(size)
    every i := 0 to n - 1 do
        every j := 0 to n - 1 do {
            a[i * n + j + 1] := (i + j) % 7
            b[i * n + j + 1] := (i * j) % 5
        }
    every i := 0 to n - 1 do
        every j := 0 to n - 1 do {
            s := 0
            every k := 0 to n - 1 do
                s +:= a[i * n + k + 1] * b[k * n + j + 1]
            c[i * n + j + 1] := s
        }
    total := 0
    every total +:= !c
    write(&errout, "TIME_MS=", &time - ssT0)
    write(total)
end
