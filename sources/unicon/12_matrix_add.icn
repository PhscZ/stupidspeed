# task 12 matrix_add — expected output: 999000000
# build: unicon -s 12_matrix_add.icn    run: 12_matrix_add.exe
# Three 1000x1000 matrices as flat `list`s indexed `i * n + j + 1`, because Unicon's only
# built-in aggregate is the 1-indexed list and a list of lists allocates 1000 extra objects.

procedure main()
    n := 1000
    size := n * n
    a := list(size); b := list(size); c := list(size)
    every i := 0 to n - 1 do
        every j := 0 to n - 1 do {
            a[i * n + j + 1] := i + j
            b[i * n + j + 1] := i - j
        }
    every k := 1 to size do
        c[k] := a[k] + b[k]
    total := 0
    every total +:= !c
    write(total)
end
