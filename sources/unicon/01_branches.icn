# task 01 branches — expected output: 33333334 13333333 7619048 45714285
# build: unicon -s 01_branches.icn    run: 01_branches.exe
# Unicon 13.3. `every i := 0 to N do` is Unicon's counted iteration; the language has no
# C-style for. The if/else chain is written as the spec asks, one test per iteration.

procedure main()
    a := 0; b := 0; c := 0; d := 0
    every i := 0 to 99999999 do {
        if i % 3 = 0 then a +:= 1
        else if i % 5 = 0 then b +:= 1
        else if i % 7 = 0 then c +:= 1
        else d +:= 1
    }
    write(a, " ", b, " ", c, " ", d)
end
