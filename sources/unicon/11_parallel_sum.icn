# task 11 parallel_sum — expected output: 7500000075000000
# build: unicon -s 11_parallel_sum.icn    run: 11_parallel_sum.exe
# Four real OS threads. Unicon's `thread` keyword creates a concurrent co-expression, and
# since version 12 the runtime implements them on top of POSIX threads, so the four workers
# run on four cores. `wait(t)` blocks until a thread finishes but returns the thread, not a
# value, so each worker publishes its partial sum into a shared list marked with `mutex()`,
# which the language locks implicitly on every put. Measured on this host: 18.84 s against
# 45.73 s for the identical four chunks run serially, 2.43x on four workers.
# Requires Unicon 13.3: the 13.2 Windows release is built without concurrent threads and
# `thread` fails there with "function not supported".

global results

procedure main()
    results := mutex([])
    workers := []
    every t := 0 to 3 do
        put(workers, thread work(t))
    every wait(!workers)
    total := 0
    every total +:= !results
    write(total)
end

procedure work(t)
    lo := t * 25000000
    hi := lo + 25000000
    acc := 0
    every i := lo to hi - 1 do {
        case i % 4 of {
            0: acc +:= 1
            1: acc +:= i
            2: acc +:= 2 * i
            3: acc +:= 3 * i
        }
    }
    put(results, acc)
end
