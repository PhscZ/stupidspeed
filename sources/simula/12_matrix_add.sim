! task 12 matrix_add — expected output: 999000000 ;
! build: cim -q -m32 -o prog 12_matrix_add.sim    run: ./prog ;
! note: -m32 asks for a 32 MB initial memory pool: the three 1000x1000 INTEGER arrays ;
!       are 8 MB each and the default pool cannot hold them, so the allocation would ;
!       abort with "Alloc: Virtual memory exhausted". ;
! note: cim.exe is a Cygwin build that drives the system gcc and links libcim.a, so ;
!       C:\cygwin64\bin must be on PATH when it is run. ;
! note: cim terminates a comment with a semicolon, which is why every header line above ;
!       ends with one. ;
begin
  integer n, i, j, total;
  integer array A(0:999, 0:999);
  integer array B(0:999, 0:999);
  integer array C(0:999, 0:999);

  n := 1000;

  for i := 0 step 1 until n - 1 do
    for j := 0 step 1 until n - 1 do
    begin
      A(i, j) := i + j;
      B(i, j) := i - j
    end;

  for i := 0 step 1 until n - 1 do
    for j := 0 step 1 until n - 1 do
      C(i, j) := A(i, j) + B(i, j);

  total := 0;
  for i := 0 step 1 until n - 1 do
    for j := 0 step 1 until n - 1 do
      total := total + C(i, j);

  OutInt(total, 0); OutImage
end
