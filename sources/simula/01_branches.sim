! task 01 branches — expected output: 33333334 13333333 7619048 45714285 ;
! build: cim -q -o prog 01_branches.sim    run: ./prog ;
! note: cim.exe is a Cygwin build that drives the system gcc and links libcim.a, so ;
!       C:\cygwin64\bin must be on PATH when it is run. -o names the executable ;
!       (prog.exe on Windows). ;
! note: Simula has no % operator: integer remainder is the procedure Mod(a, b) and ;
!       integer division is //. INTEGER is C long, 64 bits under Cygwin x86-64, so the ;
!       four counters are ordinary INTEGERs. ;
! note: cim terminates a comment with a semicolon, which is why every header line above ;
!       ends with one. ;
begin
  integer a, b, c, d, i;
  a := 0; b := 0; c := 0; d := 0;
  for i := 0 step 1 until 99999999 do
  begin
    if Mod(i, 3) = 0 then a := a + 1
    else if Mod(i, 5) = 0 then b := b + 1
    else if Mod(i, 7) = 0 then c := c + 1
    else d := d + 1
  end;
  OutInt(a, 0); OutChar(' ');
  OutInt(b, 0); OutChar(' ');
  OutInt(c, 0); OutChar(' ');
  OutInt(d, 0); OutImage
end
