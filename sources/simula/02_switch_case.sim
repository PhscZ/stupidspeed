! task 02 switch_case — expected output: 7500000075000000 ;
! build: cim -q -o prog 02_switch_case.sim    run: ./prog ;
! note: cim.exe is a Cygwin build that drives the system gcc and links libcim.a, so ;
!       C:\cygwin64\bin must be on PATH when it is run. ;
! note: Simula's own multi-way statement is inspect/when/otherwise, and cim implements ;
!       it only for ref values ("Expression after INSPECT is not of type ref" is one of ;
!       its own diagnostics), so the four-way decision on Mod(i, 4) is written as an ;
!       if/else chain. cim compiles the chain to the same compare-and-branch code a ;
!       switch would produce. ;
! note: the total is exact in 64-bit INTEGER (C long). ;
! note: cim terminates a comment with a semicolon, which is why every header line above ;
!       ends with one. ;
begin
  integer acc, i, r;
  acc := 0;
  for i := 0 step 1 until 99999999 do
  begin
    r := Mod(i, 4);
    if r = 0 then acc := acc + 1
    else if r = 1 then acc := acc + i
    else if r = 2 then acc := acc + 2 * i
    else acc := acc + 3 * i
  end;
  OutInt(acc, 0); OutImage
end
