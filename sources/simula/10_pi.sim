! task 10 pi — expected output: 4470 ;
! build: cim -q -m8 -o prog 10_pi.sim    run: ./prog ;
! note: -m8 asks cim for an 8 MB initial memory pool. The six Big objects are 40000 ;
!       limbs each, about 1.9 MB in total, which is larger than the default pool, so ;
!       without it the first allocation aborts with "Alloc: Virtual memory exhausted". ;
! note: Simula has no arbitrary-precision integers, so the state of Gibbons' unbounded ;
!       spigot is held in hand-written sign-magnitude big integers: little-endian limbs, ;
!       base 10^9, kept in an INTEGER ARRAY inside a class (INTEGER is C long, 64 bits, ;
!       which is enough for limb * small + carry, since the spigot's multiplier never ;
!       exceeds 7k + 2 for k up to about 1000). Only add, subtract, multiply by a ;
!       small integer and a quotient are implemented, the quotient the spigot asks for ;
!       is always one decimal digit, so repeated subtraction finds it. No 128-bit ;
!       arithmetic is used. ;
! note: the spigot state reaches roughly 145000 decimal digits by the 1000th digit, ;
!       about 16100 limbs, so the limb arrays are sized at 40000, well past that. Only ;
!       the sum of the digits is printed. ;
! note: the loop below is the same spigot as sources/c/10_pi.c, step for step. It forms ;
!       u = 4q + r and v = (d+1)t and emits d when u < v, otherwise it widens the state ;
!       with u = q(7k+2) + r*l and v = t*l. On emission it does u = 10(3q + r), takes the ;
!       next digit as quot(u, t) - 10*d, then r = 10(r - d*t) and q = 10q. On widening ;
!       it does r = (2q + r)*l, q = q*k, t = t*l, then k = k+1 and l = l+2. ;
! note: cim's and/or are not short-circuit operators, so the digit-trimming loop tests ;
!       the limb count before it indexes the limb array instead of writing ;
!       "while n > 0 and limb(n-1) = 0", which would index limb(-1). ;
! note: cim requires that a comment is terminated by a semicolon, and a semicolon in ;
!       the declaration part ends the declarations, so the program body below carries ;
!       no comments at all, they all live in this header. ;
! note: cim.exe is a Cygwin build that drives the system gcc and links libcim.a, so ;
!       C:\cygwin64\bin must be on PATH when it is run. ;
! note: cim terminates a comment with a semicolon, which is why every header line above ;
!       ends with one. ;
begin
  class Big;
  begin
    integer n;
    boolean neg;
    integer array limb(0:39999);
  end;

  procedure trim(x); ref(Big) x;
  begin
    boolean cont;
    cont := true;
    while cont do
    begin
      if x.n > 0 then
      begin
        if x.limb(x.n - 1) = 0 then x.n := x.n - 1 else cont := false
      end
      else cont := false
    end;
    if x.n = 0 then x.neg := false
  end;

  procedure set(x, v); ref(Big) x; integer v;
  begin
    integer w;
    w := v;
    x.n := 0; x.neg := false;
    while w > 0 do
    begin
      x.limb(x.n) := Mod(w, 1000000000);
      x.n := x.n + 1;
      w := w // 1000000000
    end
  end;

  procedure copy(dst, src); ref(Big) dst, src;
  begin
    integer i;
    i := 0;
    while i < src.n do
    begin
      dst.limb(i) := src.limb(i);
      i := i + 1
    end;
    dst.n := src.n; dst.neg := src.neg
  end;

  integer procedure cmpmag(a, b); ref(Big) a, b;
  begin
    integer i, c;
    c := 0;
    if a.n < b.n then c := -1
    else if a.n > b.n then c := 1
    else
    begin
      i := a.n;
      while i > 0 and c = 0 do
      begin
        i := i - 1;
        if a.limb(i) < b.limb(i) then c := -1
        else if a.limb(i) > b.limb(i) then c := 1
      end
    end;
    cmpmag := c
  end;

  integer procedure cmp(a, b); ref(Big) a, b;
  begin
    integer c;
    if a.neg and not b.neg then c := -1
    else if not a.neg and b.neg then c := 1
    else
    begin
      c := cmpmag(a, b);
      if a.neg then c := -c
    end;
    cmp := c
  end;

  procedure addmag(r, a, b); ref(Big) r, a, b;
  begin
    integer i, nn, carry, s;
    if a.n > b.n then nn := a.n else nn := b.n;
    carry := 0;
    for i := 0 step 1 until nn - 1 do
    begin
      s := carry;
      if i < a.n then s := s + a.limb(i);
      if i < b.n then s := s + b.limb(i);
      if s >= 1000000000 then begin s := s - 1000000000; carry := 1 end
      else carry := 0;
      r.limb(i) := s
    end;
    r.limb(nn) := carry;
    if carry > 0 then r.n := nn + 1 else r.n := nn;
    r.neg := false
  end;

  procedure submag(r, a, b); ref(Big) r, a, b;
  begin
    integer i, borrow, bi;
    borrow := 0;
    for i := 0 step 1 until a.n - 1 do
    begin
      bi := borrow;
      if i < b.n then bi := bi + b.limb(i);
      if a.limb(i) >= bi then
      begin
        r.limb(i) := a.limb(i) - bi;
        borrow := 0
      end
      else
      begin
        r.limb(i) := a.limb(i) + 1000000000 - bi;
        borrow := 1
      end
    end;
    r.n := a.n; r.neg := false;
    trim(r)
  end;

  procedure add(r, a, b); ref(Big) r, a, b;
  begin
    boolean an, bn;
    an := a.neg; bn := b.neg;
    if an eqv bn then
    begin
      addmag(r, a, b);
      r.neg := an
    end
    else if cmpmag(a, b) >= 0 then
    begin
      submag(r, a, b);
      r.neg := an
    end
    else
    begin
      submag(r, b, a);
      r.neg := bn
    end;
    trim(r)
  end;

  procedure sub(r, a, b); ref(Big) r, a, b;
  begin
    boolean an;
    an := a.neg;
    if not (an eqv b.neg) then
    begin
      addmag(r, a, b);
      r.neg := an
    end
    else if cmpmag(a, b) >= 0 then
    begin
      submag(r, a, b);
      r.neg := an
    end
    else
    begin
      submag(r, b, a);
      r.neg := not an
    end;
    trim(r)
  end;

  procedure mul(r, a, m); ref(Big) r, a; integer m;
  begin
    integer i, nn, carry, p;
    if m = 0 or a.n = 0 then
    begin
      r.n := 0;
      r.neg := false
    end
    else
    begin
      carry := 0;
      for i := 0 step 1 until a.n - 1 do
      begin
        p := a.limb(i) * m + carry;
        r.limb(i) := Mod(p, 1000000000);
        carry := p // 1000000000
      end;
      nn := a.n;
      while carry > 0 do
      begin
        r.limb(nn) := Mod(carry, 1000000000);
        nn := nn + 1;
        carry := carry // 1000000000
      end;
      r.n := nn;
      r.neg := a.neg
    end;
    trim(r)
  end;

  integer procedure quot(a, b, work); ref(Big) a, b, work;
  begin
    integer q;
    q := 0;
    if not a.neg and not b.neg and b.n > 0 then
    begin
      copy(work, b);
      while cmp(a, work) >= 0 do
      begin
        q := q + 1;
        addmag(work, work, b)
      end
    end;
    quot := q
  end;

  ref(Big) q, r, t, u, v, w;
  integer k, l, d, next, sum, produced;

  q :- new Big; r :- new Big; t :- new Big;
  u :- new Big; v :- new Big; w :- new Big;

  set(q, 1);
  set(r, 0);
  set(t, 1);

  k := 1; l := 3; d := 3;
  sum := 0; produced := 0;

  while produced < 1000 do
  begin
    mul(u, q, 4);
    add(u, u, r);
    mul(v, t, d + 1);

    if cmp(u, v) < 0 then
    begin
      sum := sum + d;
      produced := produced + 1;

      mul(u, q, 3);
      add(u, u, r);
      mul(u, u, 10);
      next := quot(u, t, w) - 10 * d;

      mul(v, t, d);
      sub(v, r, v);
      mul(r, v, 10);
      mul(q, q, 10);

      d := next
    end
    else
    begin
      mul(u, q, 7 * k + 2);
      mul(v, r, l);
      add(u, u, v);
      mul(v, t, l);
      next := quot(u, v, w);

      mul(u, q, 2);
      add(u, u, r);
      mul(u, u, l);
      copy(r, u);
      mul(q, q, k);
      mul(t, t, l);

      k := k + 1;
      l := l + 2;
      d := next
    end
  end;

  OutInt(sum, 0); OutImage
end
