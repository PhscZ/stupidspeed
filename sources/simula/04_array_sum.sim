! task 04 array_sum — expected output: 499999500000 ;
! build: cim -q -m12 -o prog 04_array_sum.sim    run: ./prog ;
! note: -m12 asks cim for a 12 MB initial memory pool. The default pool is smaller than ;
!       the 8 MB array, so without it the allocation aborts with ;
!       "Alloc: Virtual memory exhausted". The pool size is fixed when the program is ;
!       compiled. ;
! note: INTEGER is 64 bits, so the million-element array is 8 MB. ;
! note: cim.exe is a Cygwin build that drives the system gcc and links libcim.a, so ;
!       C:\cygwin64\bin must be on PATH when it is run. ;
! note: cim terminates a comment with a semicolon, which is why every header line above ;
!       ends with one. ;
begin
  integer i, total;
  integer array a(0:999999);
  for i := 0 step 1 until 999999 do a(i) := i;
  total := 0;
  for i := 0 step 1 until 999999 do total := total + a(i);
  OutInt(total, 0); OutImage
end
