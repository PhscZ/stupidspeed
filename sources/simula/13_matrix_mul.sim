! task 13 matrix_mul — expected output: 599995000 ;
! build: cim -q -m8 -o prog 13_matrix_mul.sim    run: ./prog ;
! note: -m8 asks for an 8 MB initial memory pool: the three 500x500 INTEGER arrays are ;
!       2 MB each and the default pool cannot hold them, so the allocation would abort ;
!       with "Alloc: Virtual memory exhausted". ;
! note: plain i, j, k triple loop, in that order, with no blocking or reordering. ;
! note: cim.exe is a Cygwin build that drives the system gcc and links libcim.a, so ;
!       C:\cygwin64\bin must be on PATH when it is run. ;
! note: cim terminates a comment with a semicolon, which is why every header line above ;
!       ends with one. ;
begin
  integer n, i, j, k, s, total;
  integer array A(0:499, 0:499);
  integer array B(0:499, 0:499);
  integer array C(0:499, 0:499);

  n := 500;

  for i := 0 step 1 until n - 1 do
    for j := 0 step 1 until n - 1 do
    begin
      A(i, j) := Mod(i + j, 7);
      B(i, j) := Mod(i * j, 5)
    end;

  for i := 0 step 1 until n - 1 do
    for j := 0 step 1 until n - 1 do
    begin
      s := 0;
      for k := 0 step 1 until n - 1 do
        s := s + A(i, k) * B(k, j);
      C(i, j) := s
    end;

  total := 0;
  for i := 0 step 1 until n - 1 do
    for j := 0 step 1 until n - 1 do
      total := total + C(i, j);

  OutInt(total, 0); OutImage
end
