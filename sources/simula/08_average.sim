! task 08 average — expected output: 0.498046875 ;
! build: cim -q -o prog 08_average.sim    run: ./prog ;
! note: REAL is IEEE 64-bit double. OutFix(r, w, d) is Simula's fixed-point output and ;
!       its first parameter is the number of digits after the decimal point, so ;
!       OutFix(x, 9, 0) prints exactly nine decimals with no leading blanks. ;
! note: cim.exe is a Cygwin build that drives the system gcc and links libcim.a, so ;
!       C:\cygwin64\bin must be on PATH when it is run. ;
! note: cim terminates a comment with a semicolon, which is why every header line above ;
!       ends with one. ;
begin
  integer i;
  real total;
  total := 0.0;
  for i := 0 step 1 until 99999999 do
    total := total + Mod(i, 256) / 256.0;
  OutFix(total / 100000000.0, 9, 0); OutImage
end
