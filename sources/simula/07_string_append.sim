! task 07 string_append — expected output: 1000000 ;
! build: cim -q -m8 -o prog 07_string_append.sim    run: ./prog ;
! note: -m8 asks cim for an 8 MB initial memory pool. The one million character buffer ;
!       is 1 MB and the default pool is smaller, so without it the allocation aborts ;
!       with "Alloc: Virtual memory exhausted". ;
! note: Simula's TEXT is a fixed-length frame of at most 65535 characters, so a million ;
!       character text cannot exist and text := text & "x" is not expressible at this ;
!       size. The appends therefore grow the string in place at the end of a CHARACTER ;
!       ARRAY, the same way the Modula-2 and Oberon-2 rows of this benchmark do it. ;
!       The length that is printed is found by scanning the buffer for the terminator, ;
!       so it is the length of the string that was built, not the size of the buffer. ;
! note: cim.exe is a Cygwin build that drives the system gcc and links libcim.a, so ;
!       C:\cygwin64\bin must be on PATH when it is run. ;
! note: cim terminates a comment with a semicolon, which is why every header line above ;
!       ends with one. ;
begin
  character array buf(0:1000000);
  integer len, i;

  len := 0;
  for i := 0 step 1 until 999999 do
  begin
    buf(len) := 'x';
    len := len + 1
  end;
  buf(len) := Char(0);

  len := 0;
  while buf(len) <> Char(0) do len := len + 1;

  OutInt(len, 0); OutImage
end
