! task 07 string_append — expected output: 1000000 ;
! build: cim -q -m8 -o prog 07_string_append.sim    run: ./prog ;
! note: -m8 asks cim for an 8 MB initial memory pool. The two million-character ;
!       buffers fit in that pool; the default pool is smaller and allocation aborts ;
!       with "Alloc: Virtual memory exhausted". ;
! note: Simula's TEXT is a fixed-length frame of at most 65535 characters, so a million ;
!       character text cannot exist and text := text & "x" is not expressible at this ;
!       size. Each append copies the entire current text including its terminator into ;
!       the alternate CHARACTER ARRAY, overwrites that terminator with x, then swaps ;
!       buffers. The printed length is found by scanning the active buffer. ;
! note: cim.exe is a Cygwin build that drives the system gcc and links libcim.a, so ;
!       C:\cygwin64\bin must be on PATH when it is run. ;
! note: cim terminates a comment with a semicolon, which is why every header line above ;
!       ends with one. ;
begin
  character array bufA(0:1000000), bufB(0:1000000);
  integer len, i, j, active;

  len := 0;
  active := 0;
  bufA(0) := Char(0);
  for i := 1 step 1 until 1000000 do
  begin
    if active = 0 then
    begin
      for j := 0 step 1 until len do bufB(j) := bufA(j);
      bufB(len) := 'x';
      len := len + 1;
      bufB(len) := Char(0);
      active := 1
    end
    else
    begin
      for j := 0 step 1 until len do bufA(j) := bufB(j);
      bufA(len) := 'x';
      len := len + 1;
      bufA(len) := Char(0);
      active := 0
    end
  end;

  len := 0;
  if active = 0 then
  begin
    while bufA(len) <> Char(0) do len := len + 1
  end
  else
  begin
    while bufB(len) <> Char(0) do len := len + 1
  end;

  OutInt(len, 0); OutImage
end
