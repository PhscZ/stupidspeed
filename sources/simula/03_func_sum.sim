! task 03 func_sum — expected output: 100000000 ;
! build: cim -q -o prog 03_func_sum.sim    run: ./prog ;
! note: cim.exe is a Cygwin build that drives the system gcc and links libcim.a, so ;
!       C:\cygwin64\bin must be on PATH when it is run. ;
! note: the call survives optimisation without any no-inline marker. cim compiles every ;
!       Simula procedure to its own C function and every call site goes through the ;
!       runtime's procedure dispatcher __rcp in libcim.a, which is a static library ;
!       linked without LTO, so gcc cannot inline it. The hundred million calls really ;
!       happen: the program takes about 18 seconds, against 5.7 seconds for task 01's ;
!       equally sized loop. ;
! note: the procedure is declared inside the main block, so it needs no second ;
!       translation unit. cim gives every call a fresh procedure data object, so Simula ;
!       procedures are reentrant and task 09's recursion works the same way. ;
! note: cim terminates a comment with a semicolon, which is why every header line above ;
!       ends with one. ;
begin
  integer v, i;
  integer procedure addone(n); integer n;
  begin
    addone := n + 1
  end;
  v := 0;
  for i := 0 step 1 until 99999999 do v := addone(v);
  OutInt(v, 0); OutImage
end
