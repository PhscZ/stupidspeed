! task 14 file_read — expected output: 2389704704 ;
! build: cim -q -o prog 14_file_read.sim    run: ./prog ;
! note: data.bin (50 MiB, the bytes 0..255 repeating) must be in the working directory. ;
! note: Simula's byte file interface is byte-at-a-time: INBYTEFILE.inbyte reads one byte ;
!       per call and there is no bulk read in the Oakwood file classes, so the 50 MB ;
!       arrive one byte per call. That is why the run takes about 15 seconds. ;
! note: the total is reduced with // and the arithmetic, not with a bitwise and, since ;
!       Simula has no bit operators for INTEGER. ;
! note: cim.exe is a Cygwin build that drives the system gcc and links libcim.a, so ;
!       C:\cygwin64\bin must be on PATH when it is run. ;
! note: cim terminates a comment with a semicolon, which is why every header line above ;
!       ends with one. ;
begin
  ref(inbytefile) f;
  integer i, total, b;

  total := 0;
  f :- new inbytefile("data.bin");
  f.open;
  for i := 1 step 1 until 52428800 do
  begin
    b := f.inbyte;
    total := total + b
  end;
  f.close;

  total := total - (total // 4294967296) * 4294967296;
  OutInt(total, 0); OutImage
end
