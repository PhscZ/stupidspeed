# task 05 alloc_churn — expected output: 1274991808
# build: s7c -O2 prog.sd7    run: ./prog
# note: Seed7 has no raw malloc; the closest thing to a 64-byte buffer is a 64-character
#       string, which is what this uses. Strings are heap objects with their own lifetime
#       management, so the buffer a slot replaces is released by the runtime rather than by
#       an explicit free, and 'slots' keeps the current 256 buffers reachable exactly as
#       the other rows' slot array does.
# note: the store into the buffer is '@:=' rather than '[i] :=': a string index is not an
#       assignable location in Seed7, only a readable one, and 'buf[1] := chr(...)' is a
#       compile error ("Variable expected ... found expression of type func char").

$ include "seed7_05.s7i";
  include "time.s7i";

(* timing: GET_TIME (TIM_NOW) is Seed7's clock, giving the local time of day down to
   the microsecond; TIME_MS goes to stderr with writeln(STD_ERR, ...), and stdout is
   unchanged. Verified on this machine with s7c 3.5.10: all fifteen compiled tasks
   print the expected line and the TIME_MS line on stderr. *)
const func integer: ssNowMs is func
  result
    var integer: ms is 0;
  local
    var integer: year is 0;
    var integer: month is 0;
    var integer: day is 0;
    var integer: hour is 0;
    var integer: minute is 0;
    var integer: second is 0;
    var integer: micro_second is 0;
    var integer: timeZone is 0;
    var boolean: daylightSavingTime is FALSE;
  begin
    GET_TIME(year, month, day, hour, minute, second, micro_second, timeZone, daylightSavingTime);
    ms := ((hour * 60 + minute) * 60 + second) * 1000 + micro_second div 1000;
  end func;

const proc: ssReport (in integer: t0) is func
  local
    var integer: ms is 0;
  begin
    ms := ssNowMs - t0;
    writeln(STD_ERR, "TIME_MS=" <& str(ms));
  end func;

const proc: main is func
  local
    var integer: ssT0 is 0;
    var array string: slots is 256 times "";
    var string: buf is "";
    var integer: total is 0;
    var integer: i is 0;
  begin
    ssT0 := ssNowMs;
    for i range 0 to 9999999 do
      buf := "\0;" mult 64;
      buf @:= [1] chr(i mod 256);
      total +:= ord(buf[1]);

      slots[(i mod 256) + 1] := buf;
    end for;

    ssReport(ssT0);
    writeln(total);
  end func;
