# task 12 matrix_add — expected output: 999000000
# build: s7c -O2 prog.sd7    run: ./prog
# note: a two-dimensional array must be given a named type at the top level in Seed7.
#       Written as 'array array integer' in two places the compiler treats the two
#       occurrences as different types and fails with a NO_MATCH error, so 'matrix' is
#       declared once and used everywhere.
# note: Seed7 arrays carry their own index range and 'n times n times 0' makes one indexed
#       1 .. n, so the loops count 1 .. n and subtract 1 to keep the same 0-based values
#       the other rows use.

$ include "seed7_05.s7i";
  include "time.s7i";

(* timing: GET_TIME (TIM_NOW) is Seed7's clock, giving the local time of day down to
   the microsecond; TIME_MS goes to stderr with writeln(STD_ERR, ...), and stdout is
   unchanged. Verified on this machine with s7c 3.5.10: all fifteen compiled tasks
   print the expected line and the TIME_MS line on stderr. *)
const func integer: ssNowMs is func
  result
    var integer: ms is 0;
  local
    var integer: year is 0;
    var integer: month is 0;
    var integer: day is 0;
    var integer: hour is 0;
    var integer: minute is 0;
    var integer: second is 0;
    var integer: micro_second is 0;
    var integer: timeZone is 0;
    var boolean: daylightSavingTime is FALSE;
  begin
    GET_TIME(year, month, day, hour, minute, second, micro_second, timeZone, daylightSavingTime);
    ms := ((hour * 60 + minute) * 60 + second) * 1000 + micro_second div 1000;
  end func;

const proc: ssReport (in integer: t0) is func
  local
    var integer: ms is 0;
  begin
    ms := ssNowMs - t0;
    writeln(STD_ERR, "TIME_MS=" <& str(ms));
  end func;

const type: matrix is array array integer;

const proc: main is func
  local
    var integer: ssT0 is 0;
    const integer: n is 1000;
    var matrix: a is 0 times 0 times 0;
    var matrix: b is 0 times 0 times 0;
    var matrix: c is 0 times 0 times 0;
    var integer: total is 0;
    var integer: i is 0;
    var integer: j is 0;
  begin
    ssT0 := ssNowMs;
    a := n times n times 0;
    b := n times n times 0;
    c := n times n times 0;

    for i range 1 to n do
      for j range 1 to n do
        a[i][j] := (i - 1) + (j - 1);
        b[i][j] := (i - 1) - (j - 1);
      end for;
    end for;

    for i range 1 to n do
      for j range 1 to n do
        c[i][j] := a[i][j] + b[i][j];
      end for;
    end for;

    for i range 1 to n do
      for j range 1 to n do
        total +:= c[i][j];
      end for;
    end for;

    ssReport(ssT0);
    writeln(total);
  end func;
