# task 11 parallel_sum — expected output: 7500000075000000
# build: s7c -O2 prog.sd7    run: ./prog
# note: Seed7 has no thread library at all. Its only concurrency facility is process.s7i,
#       so this is four child processes rather than four threads, the same shape the
#       VBScript and COBOL rows use and the R row uses with PSOCK workers. The benchmark
#       accepts it as "pass, but with processes rather than threads", and unlike the R and
#       COBOL rows it is real parallelism on Windows: four cores work at once.
# note: the parent starts four copies of this same executable with startPipe, handing each
#       child its worker index as its only argument. Each child computes one quarter of
#       task 02's switch and prints its partial; the parent reads the partial with getln on
#       childStdOut and joins with waitFor, then adds the four partials.
# note: each worker owns a fixed quarter, so which one finishes first cannot change the
#       answer. The child's path comes from path(PROGRAM), so the parent can be started
#       from any working directory.
# note: measured: one child (a quarter of the work) takes about 240 ms and the full four-child
#       run about 350 ms, where four children one after another would be about 960 ms, so the
#       four really do run at the same time. The wall time is nevertheless dominated by the
#       ~200-250 ms Seed7 runtime startup that every compiled Seed7 program pays, so this cell
#       comes out no faster than task 02, which does the whole 100000000 iterations in one
#       process. The answer is right and the parallelism is real; the speedup is not visible at
#       these loop counts.

$ include "seed7_05.s7i";
  include "process.s7i";

(* timing: GET_TIME (TIM_NOW) is Seed7's clock, giving the local time of day down to
   the microsecond; TIME_MS goes to stderr with writeln(STD_ERR, ...), and stdout is
   unchanged. Instrumented by inspection: Seed7 is not installed on this machine, so
   this row's timing is unverified. *)
const func integer: ssNowMs is func
  result
    var integer: ms is 0;
  local
    var integer: year is 0;
    var integer: month is 0;
    var integer: day is 0;
    var integer: hour is 0;
    var integer: minute is 0;
    var integer: second is 0;
    var integer: micro_second is 0;
    var integer: timeZone is 0;
    var boolean: daylightSavingTime is FALSE;
  begin
    GET_TIME(year, month, day, hour, minute, second, micro_second, timeZone, daylightSavingTime);
    ms := ((hour * 60 + minute) * 60 + second) * 1000 + micro_second div 1000;
  end func;

const proc: ssReport (in integer: t0) is func
  local
    var integer: ms is 0;
  begin
    ms := ssNowMs - t0;
    writeln(STD_ERR, "TIME_MS=" <& str(ms));
  end func;

const integer: SPAN is 25000000;

const func integer: workRange (in integer: t) is func
  result
    var integer: acc is 0;
  local
    var integer: lo is 0;
    var integer: hi is 0;
    var integer: i is 0;
  begin
    lo := t * SPAN;
    hi := lo + SPAN;
    for i range lo to hi - 1 do
      case i mod 4 of
        when {0}: acc +:= 1;
        when {1}: acc +:= i;
        when {2}: acc +:= 2 * i;
        when {3}: acc +:= 3 * i;
      end case;
    end for;
  end func;

const proc: main is func
  local
    var integer: ssT0 is 0;
    var array process: kids is 0 times process.value;
    var array string: parameters is 0 times "";
    var file: out is STD_NULL;
    var integer: t is 0;
    var integer: total is 0;
  begin
    ssT0 := ssNowMs;
    if length(argv(PROGRAM)) = 1 then
      # child: compute one quarter and print it
      writeln(workRange(integer(argv(PROGRAM)[1])));
    else
      for t range 0 to 3 do
        parameters := 0 times "";
        parameters &:= str(t);
        kids &:= startPipe(path(PROGRAM), parameters);
      end for;

      for t range 1 to 4 do
        out := childStdOut(kids[t]);
        total +:= integer(getln(out));
        waitFor(kids[t]);
      end for;

      ssReport(ssT0);
      writeln(total);
    end if;
  end func;
