# task 13 matrix_mul — expected output: 599995000
# build: s7c -O2 prog.sd7    run: ./prog
# note: same named-type requirement as task 12: 'array array integer' must be declared as
#       a type once, otherwise the two occurrences count as different types.
# note: the triple loop is plain i, j, k in that order, with no blocking or reordering, so
#       it is the same algorithm as the C row.

$ include "seed7_05.s7i";

const type: matrix is array array integer;

const proc: main is func
  local
    const integer: n is 500;
    var matrix: a is 0 times 0 times 0;
    var matrix: b is 0 times 0 times 0;
    var matrix: c is 0 times 0 times 0;
    var integer: total is 0;
    var integer: i is 0;
    var integer: j is 0;
    var integer: k is 0;
    var integer: sum is 0;
  begin
    a := n times n times 0;
    b := n times n times 0;
    c := n times n times 0;

    for i range 1 to n do
      for j range 1 to n do
        a[i][j] := ((i - 1) + (j - 1)) mod 7;
        b[i][j] := ((i - 1) * (j - 1)) mod 5;
      end for;
    end for;

    for i range 1 to n do
      for j range 1 to n do
        sum := 0;
        for k range 1 to n do
          sum +:= a[i][k] * b[k][j];
        end for;
        c[i][j] := sum;
      end for;
    end for;

    for i range 1 to n do
      for j range 1 to n do
        total +:= c[i][j];
      end for;
    end for;

    writeln(total);
  end func;
