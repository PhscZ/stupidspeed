# task 03 func_sum — expected output: 100000000
# build: s7c -O2 prog.sd7    run: ./prog
# note: add_one lives in its own file, 03_func_sum_add_one.s7i, which this file includes.
#       That satisfies the letter of the task ("a separate file for the helper") but not
#       its intent, and the deviation is unavoidable here: Seed7 has no no-inline marker
#       (its complete pragma list is $ library, $ message, $ info, $ trace, $ decls and
#       $ names), include is textual, and s7c generates a single C translation unit per
#       program, so the helper cannot be kept in a separate object file the way the
#       Fortran, Modula-2, Vala, Tcl and SystemVerilog rows do it. The C function s7c
#       emits is 'static' and has one call site, so gcc -O2 inlines it and the
#       100000000 calls collapse into the loop: the cell measures the loop, not the calls.
#       There is no way to promise a real call, so the row does not claim one.
# note: verified on the built executable rather than assumed. The whole 100000000-iteration
#       loop is these five instructions and contains no call at all (objdump -d prog.exe):
#         mov  $0x5f5e100,%eax     ; 100000000
#         sub  $0x1,%rax
#         je   <done>
#         add  $0x1,%rcx           ; value + 1
#         jno  <loop>              ; overflow check
#       The function value route that would force a real indirect call was tried as a probe
#       and does not compile: 'var func integer: f is add_one;' and the equivalent through a
#       named 'const type: intFunc is func integer;' both fail with 'Declaration of "f"
#       failed'. So the row has no fallback and records the deviation instead.
# note: -oc3 (the Seed7 compiler's own inliner) is NOT used; at the default level Seed7
#       only inlines calls whose body is a single special action, and INT_ADD is not one.

$ include "seed7_05.s7i";
  include "03_func_sum_add_one.s7i";

const proc: main is func
  local
    var integer: value is 0;
    var integer: i is 0;
  begin
    for i range 1 to 100000000 do
      value := add_one(value);
    end for;

    writeln(value);
  end func;
