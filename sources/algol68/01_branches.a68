# task 01 branches — expected output: 33333334 13333333 7619048 45714285 #
# build: none (interpreter)    run: a68g 01_branches.a68 #
# note: Algol 68 Genie is a compiler-interpreter, so there is no build step. Its INT #
# note: is 32 bits wide, which is enough for the loop index and for the four counters. #

INT a := 0, b := 0, c := 0, d := 0;

FOR i FROM 0 TO 99999999 DO
  IF i MOD 3 = 0 THEN a +:= 1
  ELIF i MOD 5 = 0 THEN b +:= 1
  ELIF i MOD 7 = 0 THEN c +:= 1
  ELSE d +:= 1
  FI
OD;

print((whole(a, 0), " ", whole(b, 0), " ", whole(c, 0), " ", whole(d, 0), newline))
