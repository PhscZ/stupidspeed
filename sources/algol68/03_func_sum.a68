# task 03 func_sum — expected output: 100000000 #
# build: none (interpreter)    run: a68g 03_func_sum.a68 #
# note: Algol 68 Genie interprets, it never compiles a call away, so the function #
# note: needs no no-inline marker and no second translation unit: there is no inlining #
# note: to defeat. The call really happens a hundred million times. #

PROC add_one = (INT n) INT: n + 1;

INT value := 0;

FOR i FROM 0 TO 99999999 DO
  value := add_one(value)
OD;

print((whole(value, 0), newline))
