# task 03 func_sum — expected output: 100000000 #
# build: none (interpreter)    run: a68g 03_func_sum.a68 #
# note: Algol 68 Genie interprets, it never compiles a call away, so the function #
# note: needs no no-inline marker and no second translation unit: there is no inlining #
# note: to defeat. The call really happens a hundred million times. #
# timing: clock is a68g's processor-time clock, in seconds, as a REAL; for this #
# note: single-threaded interpreter that is the program's own work, which is what the #
# note: contract brackets. TIME_MS is written to stand error as a whole number of #
# note: milliseconds, and stdout is unchanged. #

REAL tim0 = clock;

PROC add_one = (INT n) INT: n + 1;

INT value := 0;

FOR i FROM 0 TO 99999999 DO
  value := add_one(value)
OD;

INT tms = ENTIER(1000.0 * (clock - tim0) + 0.5);
putf(stand error, ($g$, "TIME_MS=" + whole(tms, 0), $l$));
print((whole(value, 0), newline))
