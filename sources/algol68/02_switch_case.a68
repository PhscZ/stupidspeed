# task 02 switch_case — expected output: 7500000075000000 #
# build: none (interpreter)    run: a68g 02_switch_case.a68 #
# note: CASE selects on the value of the selector and numbers the choices from 1, so #
# note: the selector is (i MOD 4) + 1 to line the four choices up with cases 0..3. #
# note: Case labels are not accepted by this implementation, so the selector carries #
# note: the offset instead. The total is 7500000075000000, which does not fit the #
# note: 32-bit INT, so the accumulator is LONG INT. #
# timing: clock is a68g's processor-time clock, in seconds, as a REAL; for this #
# note: single-threaded interpreter that is the program's own work, which is what the #
# note: contract brackets. TIME_MS is written to stand error as a whole number of #
# note: milliseconds, and stdout is unchanged. #

REAL tim0 = clock;

LONG INT acc := 0;

FOR i FROM 0 TO 99999999 DO
  CASE (i MOD 4) + 1 IN
    acc +:= 1,
    acc +:= i,
    acc +:= 2 * i,
    acc +:= 3 * i
  ESAC
OD;

INT tms = ENTIER(1000.0 * (clock - tim0) + 0.5);
putf(stand error, ($g$, "TIME_MS=" + whole(tms, 0), $l$));
print((whole(acc, 0), newline))
