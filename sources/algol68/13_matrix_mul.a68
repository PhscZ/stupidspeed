# task 13 matrix_mul — expected output: 599995000 #
# build: none (interpreter)    run: a68g 13_matrix_mul.a68 #
# note: plain i, j, k triple loop, in that order, with no tricks: reordering it would #
# note: be faster, which is the point. n is 500, so 125 million multiply-adds. #
# timing: clock is a68g's processor-time clock, in seconds, as a REAL; for this #
# note: single-threaded interpreter that is the program's own work, which is what the #
# note: contract brackets. TIME_MS is written to stand error as a whole number of #
# note: milliseconds, and stdout is unchanged. #

REAL tim0 = clock;

INT n = 500;

[0:n - 1, 0:n - 1] INT a, b, c;

FOR i FROM 0 TO n - 1 DO
  FOR j FROM 0 TO n - 1 DO
    a[i, j] := (i + j) MOD 7;
    b[i, j] := (i * j) MOD 5
  OD
OD;

FOR i FROM 0 TO n - 1 DO
  FOR j FROM 0 TO n - 1 DO
    INT sum := 0;
    FOR k FROM 0 TO n - 1 DO
      sum +:= a[i, k] * b[k, j]
    OD;
    c[i, j] := sum
  OD
OD;

INT total := 0;

FOR i FROM 0 TO n - 1 DO
  FOR j FROM 0 TO n - 1 DO
    total +:= c[i, j]
  OD
OD;

INT tms = ENTIER(1000.0 * (clock - tim0) + 0.5);
putf(stand error, ($g$, "TIME_MS=" + whole(tms, 0), $l$));
print((whole(total, 0), newline))
