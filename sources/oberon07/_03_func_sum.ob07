(* task 03 func_sum — expected output: 100000000 *)
(* build: Compiler.exe _03_func_sum.ob07 win64con -out prog.exe    run: prog.exe *)
(* note: the call has to survive, and Oberon-07 has no no-inline marker, so AddOne lives in *)
(*       its own module (AddOne.ob07, beside this file) and the call is a real cross-module *)
(*       call. The compiler pulls the imported module in by itself; there is no separate *)
(*       compile step. It has no inliner either, so nothing could have removed the call. *)
(* note: the helper file is AddOne.ob07, and this compiler requires an imported module's name *)
(*       to equal its file name (error 23 otherwise), so the helper's MODULE line is AddOne. *)
(*       An underscore is a legal identifier character here (STRINGS.letter accepts it), so *)
(*       _03_func_sum_add_one.ob07 would compile too; AddOne is used because the helper *)
(*       exports AddOne and the Oberon convention is to name the module after what it *)
(*       exports, which is what the Oberon-2 row does with its AddOne module. *)
(* note: Compiler.exe is C:\stupidspeed\tools\oberon07\oberon-07-compiler-master\Compiler.exe, *)
(*       which has no optimisation switch; the build line above is the whole story. *)
(* note: the line is ended with Out.Char(0AX) and not Out.Ln. Out.Ln prints CR LF, and msvcrt *)
(*       text mode then translates that LF a second time, so the pipe receives CR CR LF; a *)
(*       lone LF from Out.Char goes through the same translation as one CR LF, the normal *)
(*       Windows line ending. Nothing else in the output is affected. *)

MODULE _03_func_sum;
IMPORT Out, AddOne;

VAR
  value: INTEGER;
  i: INTEGER;

BEGIN
  value := 0;
  FOR i := 1 TO 100000000 DO
    value := AddOne.AddOne(value)
  END;

  Out.Int(value, 1); Out.Char(0AX)
END _03_func_sum.
