(* task 12 matrix_add — expected output: 999000000 *)
(* build: Compiler.exe _12_matrix_add.ob07 win64con -out prog.exe    run: prog.exe *)
(* note: three 1000 by 1000 arrays of INTEGER, eight megabytes each, filled and then summed *)
(*       in separate loops, so the last loop walks memory rather than the values it just *)
(*       wrote. Module level arrays are static, so they are three 8 MB blocks in the *)
(*       module's data segment. *)
(* note: Compiler.exe is C:\stupidspeed\tools\oberon07\oberon-07-compiler-master\Compiler.exe, *)
(*       which has no optimisation switch; the build line above is the whole story. *)
(* note: the line is ended with Out.Char(0AX) and not Out.Ln. Out.Ln prints CR LF, and msvcrt *)
(*       text mode then translates that LF a second time, so the pipe receives CR CR LF; a *)
(*       lone LF from Out.Char goes through the same translation as one CR LF, the normal *)
(*       Windows line ending. Nothing else in the output is affected. *)

MODULE _12_matrix_add;
IMPORT Out;

CONST
  N = 1000;

VAR
  a, b, c: ARRAY N, N OF INTEGER;
  total: INTEGER;
  i, j: INTEGER;

BEGIN
  FOR i := 0 TO N - 1 DO
    FOR j := 0 TO N - 1 DO
      a[i, j] := i + j;
      b[i, j] := i - j
    END
  END;

  FOR i := 0 TO N - 1 DO
    FOR j := 0 TO N - 1 DO
      c[i, j] := a[i, j] + b[i, j]
    END
  END;

  total := 0;
  FOR i := 0 TO N - 1 DO
    FOR j := 0 TO N - 1 DO
      total := total + c[i, j]
    END
  END;

  Out.Int(total, 1); Out.Char(0AX)
END _12_matrix_add.
