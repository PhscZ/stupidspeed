-- task 12 matrix_add — expected output: 999000000
-- build: cmd.exe /c "..\..\tools\nelua\nelua.bat" -r -o 12_matrix_add.exe 12_matrix_add.nelua
-- run: ./12_matrix_add.exe
-- measured: 0.0424 s wall clock (min of 3 runs), against 0.0020 s for the fill and the
--       add as timed inside the program — this cell is almost entirely process start-up.
-- note: `-r` is this compiler's `-O2` equivalent (gcc `-O2 -DNDEBUG` plus the
--       compiler's `nochecks` pragma); see 01_branches.nelua.
-- note: Nelua's `array` is a fixed-size value type, so `[1000][1000]integer` is 8 MB and
--       cannot be a local. The three matrices are heap pointers to such arrays:
--       `*[1000][1000]integer`, allocated with `new`. The generated C is
--       `A->v[i][j]` over a contiguous C 2-D array, row-major, so the walk is the same
--       sequential memory access the task is about, with no per-row indirection.
-- note: `new` zero-initialises (it calls alloc0), and the three 8 MB allocations
--       measured 0.0000 s: the OS hands out zero pages lazily and the cost is paid on
--       first touch, which is what the fill loop then does. That is the same behaviour
--       the C row gets from calloc/malloc, and it is why the allocation is not part of
--       the measurement.
-- note: every element of C is i + j + (i - j) = 2i, so the sum is exact in int64 and
--       the answer 999000000 is printed as plain digits. With -r there is no bounds
--       check on any index.
-- note: measured on this host, built with -r: fill plus add 0.0020 s. The same task in
--       flat-index form (a single `*[1000000]integer` indexed i * n + j) measured
--       0.0056 s and gives the same sum; the 2-D spelling is used because it reads like
--       the spec.
require 'io'
require 'os'
require 'string'
require 'allocators.default'

-- timing: os.now is Nelua's monotonic clock in seconds (nanosecond resolution on
--         Windows, via QueryPerformanceCounter); TIME_MS goes to stderr through
--         io.stderr and stdout is unchanged.
local ssT0 = os.now()
local function ss_report()
  io.stderr:write(string.format('TIME_MS=%.3f\n', (os.now() - ssT0) * 1000))
end

local n: integer = 1000

local A: *[1000][1000]integer = new(@[1000][1000]integer)
local B: *[1000][1000]integer = new(@[1000][1000]integer)
local C: *[1000][1000]integer = new(@[1000][1000]integer)

for i = 0, n - 1 do
  for j = 0, n - 1 do
    A[i][j] = i + j
    B[i][j] = i - j
  end
end

for i = 0, n - 1 do
  for j = 0, n - 1 do
    C[i][j] = A[i][j] + B[i][j]
  end
end

local total: integer = 0
for i = 0, n - 1 do
  for j = 0, n - 1 do
    total = total + C[i][j]
  end
end

ss_report()
print(total)
