-- task 06 char_count — expected output: 10000000
-- build: cmd.exe /c "..\..\tools\nelua\nelua.bat" -r -o 06_char_count.exe 06_char_count.nelua
-- run: ./06_char_count.exe
-- measured: 0.0707 s wall clock (min of 3 runs), against 0.0582 s (100 MB build plus
--       scan) as timed inside the program.
-- note: `-r` is this compiler's `-O2` equivalent (gcc `-O2 -DNDEBUG` plus the
--       compiler's `nochecks` pragma); see 01_branches.nelua.
-- note: the 100 MB string is built once by `string.rep('abcdefghij', 10000000)` — the
--       whole block repeated, not appended in a loop, so the build is not part of the
--       scan. It is a GC allocation of 100000000 bytes; the collector's `pause = 200`
--       means it will not start a cycle while it is the only live object.
-- note: the string is indexed by byte (`text[i]` gives a `byte`), which is the same
--       per-character walk the spec describes. The literals are compared as bytes with
--       the `_b` suffix, which is how Nelua spells a byte constant; comparing the
--       `byte` against a `string` would not type-check.
-- note: **Nelua strings are 1-based** while arrays and spans are 0-based, so the walk
--       is `for i = 1, #text do`. This is not a detail to get wrong: under -r there is
--       no bounds check, so a 0-based loop over a string silently reads the byte
--       *before* the buffer and skips the last one. Verified directly: for
--       `c = 'xyz'`, `c[1]`, `c[2]`, `c[3]` are 120, 121, 122 and `c[0]` is whatever
--       byte precedes the allocation.
-- note: measured on this host, built with -r: build 0.0401 s, scan 0.0181 s. With -r
--       there is no bounds check in the index, so the loop is a plain load, compare and
--       branch per byte.
require 'io'
require 'os'
require 'string'

-- timing: os.now is Nelua's monotonic clock in seconds (nanosecond resolution on
--         Windows, via QueryPerformanceCounter); TIME_MS goes to stderr through
--         io.stderr and stdout is unchanged.
local ssT0 = os.now()
local function ss_report()
  io.stderr:write(string.format('TIME_MS=%.3f\n', (os.now() - ssT0) * 1000))
end

local text: string = string.rep('abcdefghij', 10000000)
local count: integer = 0

for i = 1, #text do
  local ch: byte = text[i]
  if ch == 'a'_b then
    -- skip
  elseif ch == 'e'_b then
    -- skip
  elseif ch == 'h'_b then
    count = count + 1
  else
    -- skip
  end
end

ss_report()
print(count)
