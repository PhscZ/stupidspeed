-- task 07 string_append — expected output: 250000
-- build: cmd.exe /c "..\..\tools\nelua\nelua.bat" -r -o 07_string_append.exe 07_string_append.nelua
-- run: ./07_string_append.exe
-- note: Nelua's `string` is immutable — `..` allocates a fresh buffer, copies the
--       accumulator into it and then appends the new bytes — so this loop copies about
--       3.1x10^10 bytes over the 250000 iterations. That is the quadratic copy the task
--       exists to measure, and this is the row's slowest cell.
-- note: the standard library ships lib/stringbuilder.nelua, a growable buffer that
--       would make this linear, and it is deliberately not used: that would measure a
--       different program. It is the same disclosure the Haxe row makes for StringBuf
--       and the Beef row makes for its mutable string.
-- note: the printed value is the length, so the loop cannot be deleted.
-- note: `require 'string'` is required for `..` itself: Nelua's concatenation operator
--       is defined by the string module, and without it the compiler rejects
--       `text .. 'x'` with "invalid operation between types 'string' and 'string'".
require 'io'
require 'os'
require 'string'

-- timing: os.now is Nelua's monotonic clock in seconds (nanosecond resolution on
--         Windows, via QueryPerformanceCounter); TIME_MS goes to stderr through
--         io.stderr and stdout is unchanged.
local ssT0 = os.now()
local function ss_report()
  io.stderr:write(string.format('TIME_MS=%.3f\n', (os.now() - ssT0) * 1000))
end

local text: string = ''

for i = 1, 250000 do
  text = text .. 'x'
end

ss_report()
print(#text)
