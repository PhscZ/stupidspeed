-- task 04 array_sum — expected output: 499999500000
-- build: cmd.exe /c "..\..\tools\nelua\nelua.bat" -r -o 04_array_sum.exe 04_array_sum.nelua
-- run: ./04_array_sum.exe
-- measured: 0.0202 s wall clock (min of 3 runs), against 0.0017 s for the fill and the
--       sum together as timed inside the program.
-- note: `-r` is this compiler's `-O2` equivalent (gcc `-O2 -DNDEBUG` plus the
--       compiler's `nochecks` pragma); see 01_branches.nelua.
-- note: Nelua's `array` is a fixed-size *value* type, so `[1000000]integer` is 8 MB and
--       a local one would live on the stack. It is allocated on the heap instead:
--       `new(@[1000000]integer)`, which under the default allocator is
--       gc_allocator:new -> general_allocator:alloc (C `malloc`) plus a registration
--       with the collector. The returned pointer indexes exactly like the array, and
--       the generated C is a plain `int64_t (*arr)[1000000]`, contiguous.
-- note: `new` zero-initialises (it calls alloc0), so the array starts at 0 and every
--       element is written by the first loop anyway. The three 8 MB allocations in the
--       task-12 shape cost 0.0000 s, because the OS hands out zero pages lazily and the
--       cost is paid on first touch.
-- note: the total 499999500000 is below 2^63, so the sum is exact. With -r there is no
--       bounds check on either index.
-- note: `require 'allocators.default'` is what brings `new` into scope; requiring
--       `memory` alone is not enough. `allocators.default` resolves to `gc_allocator`
--       while the GC is on, which is the default, and that forwards the actual
--       allocation to C `malloc` (see 05_alloc_churn.nelua for the details).
require 'allocators.default'

local arr: *[1000000]integer = new(@[1000000]integer)

for i = 0, 999999 do
  arr[i] = i
end

local total: integer = 0
for i = 0, 999999 do
  total = total + arr[i]
end

print(total)
