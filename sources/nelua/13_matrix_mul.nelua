-- task 13 matrix_mul — expected output: 599995000
-- build: cmd.exe /c "..\..\tools\nelua\nelua.bat" -r -o 13_matrix_mul.exe 13_matrix_mul.nelua
-- run: ./13_matrix_mul.exe
-- measured: 0.0867 s wall clock (min of 3 runs), against 0.0489 s for the triple loop as
--       timed inside the program.
-- note: `-r` is this compiler's `-O2` equivalent (gcc `-O2 -DNDEBUG` plus the
--       compiler's `nochecks` pragma); see 01_branches.nelua.
-- note: the plain triple loop, no reordering and no blocking, exactly as specified —
--       the i, j, k order is what makes it the unoptimised 125 million multiply-adds
--       the task wants. The arrays are heap pointers to fixed-size 2-D arrays
--       (`*[500][500]integer`, 2 MB each), the same shape task 12 uses; the generated C
--       indexes them as `M->v[i][k]` and `P->v[k][j]` over contiguous row-major storage.
-- note: `(i + j) % 7` and `(i * j) % 5` on non-negative int64 operands: the compiler
--       emits its inline floor-mod helper, which gcc inlines and folds to a bare `%`.
--       Both values are small, so the products inside the innermost loop stay far below
--       2^63 and the result 599995000 is exact.
-- note: measured on this host, built with -r: 0.0489 s for the triple loop. The same
--       task in flat-index form measured 0.0524 s and gives the same sum.
require 'io'
require 'os'
require 'string'
require 'allocators.default'

-- timing: os.now is Nelua's monotonic clock in seconds (nanosecond resolution on
--         Windows, via QueryPerformanceCounter); TIME_MS goes to stderr through
--         io.stderr and stdout is unchanged.
local ssT0 = os.now()
local function ss_report()
  io.stderr:write(string.format('TIME_MS=%.3f\n', (os.now() - ssT0) * 1000))
end

local n: integer = 500

local A: *[500][500]integer = new(@[500][500]integer)
local B: *[500][500]integer = new(@[500][500]integer)
local C: *[500][500]integer = new(@[500][500]integer)

for i = 0, n - 1 do
  for j = 0, n - 1 do
    A[i][j] = (i + j) % 7
    B[i][j] = (i * j) % 5
  end
end

for i = 0, n - 1 do
  for j = 0, n - 1 do
    local sum: integer = 0
    for k = 0, n - 1 do
      sum = sum + A[i][k] * B[k][j]
    end
    C[i][j] = sum
  end
end

local total: integer = 0
for i = 0, n - 1 do
  for j = 0, n - 1 do
    total = total + C[i][j]
  end
end

ss_report()
print(total)
