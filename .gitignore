# Installed toolchains. Local only; BUILD.md lists what to install.
# ~28 GB of third-party compilers and runtimes, not part of the benchmark's own output.
tools/

# Scratch: build outputs, test fixtures, probes, investigation notes.
# Nothing here is part of the benchmark.
temp/

# Python bytecode from the helper scripts.
__pycache__/
*.pyc

# Harness output: a run's measurements, regenerated by every `exec/harness.py`
# invocation, and the chart `exec/plot.py` draws from them. The published
# numbers live in README.md's results table.
exec/results.json
exec/results.md
exec/results.html

# Harness and build scratch: programs' own stdout/stderr captures.
exec/**/o.txt
exec/**/e.txt
exec/**/out.txt

# sbt's build cache, written under each Scala task directory by `scala-cli` and
# `sbt`. It is pure build state, never tracked, and its generated paths (the
# `javalib`/`scalalib` sources unpacked under .scala-build/native/native/
# dependencies/) run past Windows' 260-character MAX_PATH -- which makes
# `git add .` fail outright with "Filename too long" and stage nothing at all.
.scala-build/
