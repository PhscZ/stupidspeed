# task 08 average — expected output: 0.498046875 #
# build: none (interpreter)    run: a68g 08_average.a68 #
# note: every reading is a multiple of 1/256 and the total stays well under 2^53, so #
# note: the sum is exact and the printed digits do not depend on the order of #
# note: addition. printf with $g(-11, 9)$ prints the leading zero that the fixed #
# note: operator drops. #
# timing: clock is a68g's processor-time clock, in seconds, as a REAL; for this #
# note: single-threaded interpreter that is the program's own work, which is what the #
# note: contract brackets. TIME_MS is written to stand error as a whole number of #
# note: milliseconds, and stdout is unchanged. #

REAL tim0 = clock;

REAL total := 0.0;

FOR i FROM 0 TO 99999999 DO
  REAL reading := (i MOD 256) / 256.0;
  total +:= reading
OD;

INT tms = ENTIER(1000.0 * (clock - tim0) + 0.5);
putf(stand error, ($g$, "TIME_MS=" + whole(tms, 0), $l$));
printf(($g(-11, 9)$, total / 100000000.0));
print(newline)
