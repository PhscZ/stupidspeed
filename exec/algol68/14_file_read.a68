# task 14 file_read — expected output: 2389704704 #
# build: none (interpreter)    run: a68g 14_file_read.a68 #
# note: data.bin is read in 1 MiB chunks into a row of INT, four raw bytes per element: #
# note: a CHAR element would consume four bytes of the file and a BITS element four as #
# note: well (this build has 32-bit BITS), so INT is the word that lines up with the #
# note: file and keeps the chunk a whole number of elements. #
# note: this interpreter truncates OVER toward zero while MOD is floored, so the byte #
# note: extraction cannot be written as (v OVER 256) MOD 256: the low bytes of a word #
# note: are taken as differences of floored MOD results, which are exact multiples of #
# note: 256 and 65536, and the top byte comes from the truncating quotient corrected by #
# note: one when the division was inexact and the word was negative. #
# note: the byte total is 6684672000, which does not fit INT, so it is a LONG INT, and #
# note: it is reduced mod 2^32 only when it is printed. #
# note: the loop counts chunks rather than testing `end of file`. This interpreter's #
# note: binary transput never sets that flag: reading a 3 MiB file in 1 MiB chunks reports #
# note: `end of file` FALSE after every one of them, so an EOF-driven loop runs for ever #
# note: instead of stopping. The task fixes the file size at 50 MiB, so counting the #
# note: fifty chunks is both deterministic and exactly what the spec describes. #
# note: measured cost: a full 50 MiB run takes about 1.75 minutes, and a #
# note: third of that is a68g's binary transput against the extraction arithmetic over the #
# note: same bytes. Reading into LONG INT elements instead of INT would halve the element #
# note: count, but it doubles the arithmetic per element, so the four byte INT word is kept: #
# note: it is the one that lines up with the file and keeps the chunk a whole number of #
# note: elements. #
# timing: clock is a68g's processor-time clock, in seconds, as a REAL; for this #
# note: single-threaded interpreter that is the program's own work, which is what the #
# note: contract brackets. TIME_MS is written to stand error as a whole number of #
# note: milliseconds, and stdout is unchanged. #

REAL tim0 = clock;

INT chunk = 1048576;
INT chunks = 50;     # data.bin is exactly 50 MiB, so 50 chunks of 1 MiB #

FILE f;

VOID (open (f, "data.bin", stand back channel));

[1:chunk OVER 4] INT buf;

LONG INT total := 0;

FOR c TO chunks DO
  getbin (f, buf);
  INT part := 0;
  FOR i TO chunk OVER 4 DO
    INT v := buf[i];
    INT r8 := v MOD 256;
    INT r16 := v MOD 65536;
    INT r24 := v MOD 16777216;
    INT q24 := v OVER 16777216;
    IF v < 0 AND r24 /= 0 THEN
      q24 -:= 1
    FI;
    part +:= r8 + (r16 - r8) OVER 256 + (r24 - r16) OVER 65536 + (q24 MOD 256)
  OD;
  total +:= part
OD;

close (f);

INT tms = ENTIER(1000.0 * (clock - tim0) + 0.5);
putf(stand error, ($g$, "TIME_MS=" + whole(tms, 0), $l$));
print((whole(total MOD 4294967296, 0), newline))
