-- task 01 branches — expected output: 33333334 13333333 7619048 45714285
-- build: cmd.exe /c "..\..\tools\nelua\nelua.bat" -r -o 01_branches.exe 01_branches.nelua
-- run: ./01_branches.exe
-- measured: 0.1094 s wall clock (min of 3 runs, whole process including start-up),
--       against 0.0721 s for the loop itself as timed inside the program. The host was
--       shared with another benchmark while these numbers were taken.
-- note: `-r` (--release) is this compiler's `-O2` equivalent: it expands to
--       `gcc ... -fwrapv -fno-strict-aliasing -O2 -DNDEBUG` and also turns on the
--       compiler's `nochecks` pragma, which drops the array bounds, divide-by-zero
--       and overflow checks. Without a flag Nelua emits a debug build (-g, no -O,
--       checks on). `-M`/--maximum-performance is deliberately not used: it adds
--       `-Ofast -march=native -flto=auto`, which is past "normal optimization flags".
-- note: `print(a, b, c, d)` would separate the four values with tabs; the expected
--       line is space-separated, so the values go through one `string.format`.
-- note: every counter is a signed 64-bit `integer` (int64_t), and the arithmetic
--       wraps (the base cflags carry -fwrapv). The largest value here, 45714285, is
--       nowhere near the range, so nothing depends on the wrap.
-- note: `i % 3` on signed operands emits the compiler's inline floor-mod helper
--       (nelua_imod_nlint64: `r = a % b; (r != 0 && (a ^ b) < 0) ? r + b : r`),
--       which gcc inlines and folds to a bare `%` for a non-negative counter.
--       Measured on this host at 1e8 iterations: 0.0188 s signed against 0.0189 s
--       unsigned, i.e. inside the noise, so the idiomatic signed counter stays.
require 'io'
require 'os'
require 'string'

-- timing: os.now is Nelua's monotonic clock in seconds (nanosecond resolution on
--         Windows, via QueryPerformanceCounter); TIME_MS goes to stderr through
--         io.stderr and stdout is unchanged.
local ssT0 = os.now()
local function ss_report()
  io.stderr:write(string.format('TIME_MS=%.3f\n', (os.now() - ssT0) * 1000))
end

local a: integer, b: integer, c: integer, d: integer = 0, 0, 0, 0

for i = 0, 99999999 do
  if i % 3 == 0 then
    a = a + 1
  elseif i % 5 == 0 then
    b = b + 1
  elseif i % 7 == 0 then
    c = c + 1
  else
    d = d + 1
  end
end

ss_report()
print(string.format('%d %d %d %d', a, b, c, d))
