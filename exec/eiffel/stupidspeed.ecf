		<library name="time" location="$ISE_LIBRARY\library\time\time.ecf"/>
		<cluster name="tasks" location=".\"/>
	</target>

	<target name="t05_alloc_churn">
		<root class="T05_ALLOC_CHURN" feature="make"/>
		<setting name="console_application" value="true"/>
		<capability>
			<concurrency use="none"/>
		</capability>
		<library name="base" location="$ISE_LIBRARY\library\base\base.ecf"/>
		<library name="time" location="$ISE_LIBRARY\library\time\time.ecf"/>
		<cluster name="tasks" location=".\"/>
	</target>

	<target name="t06_char_count">
		<root class="T06_CHAR_COUNT" feature="make"/>
		<setting name="console_application" value="true"/>
		<capability>
			<concurrency use="none"/>
		</capability>
		<library name="base" location="$ISE_LIBRARY\library\base\base.ecf"/>
