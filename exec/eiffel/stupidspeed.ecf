<?xml version="1.0" encoding="ISO-8859-1"?>
<!--
	stupidspeed -- one EiffelStudio configuration with one target per task.
	Build one task with, from the directory holding these sources:

		ec -batch -finalize -c_compile -config stupidspeed.ecf -target tNN_<task>

	The system is called "prog", so every target's executable is named prog.exe and
	lives in EIFGENs/<target>/F_code/.
	All targets use the plain (non-threaded) base library except t11_parallel_sum,
	which sets the concurrency capability to thread and pulls in the thread library,
	because EiffelThread is what task 11 uses.
	Two things about the ECF shape are not obvious:
	- Concurrency is not a <setting>: the parser rejects
	  <setting name="concurrency" value="thread"/> with "Invalid setting tag
	  concurrency". It is a <capability> child, spelled <concurrency use="..."/>
	  for the target's own value and support="..." for the maximum it tolerates.
	  The thread library declares support="none" and use="none", so a client that
	  wants threads must say support="thread" use="thread", otherwise ec stops with
	  VD01 "Capability Concurrency of supplier target has value None insufficient
	  for client value SCOOP".
	- <setting name="console_application" value="true"/> is what makes the
	  executable a console program. Without it gcc links with -mwindows, the
	  program is a GUI subsystem binary, and its output never reaches a pipe.
-->
<system xmlns="http://www.eiffel.com/developers/xml/configuration-1-23-0" name="prog">

	<target name="t01_branches">
		<root class="T01_BRANCHES" feature="make"/>
		<setting name="console_application" value="true"/>
		<capability>
			<concurrency use="none"/>
		</capability>
		<library name="base" location="$ISE_LIBRARY\library\base\base.ecf"/>
		<library name="time" location="$ISE_LIBRARY\library\time\time.ecf"/>
		<cluster name="tasks" location=".\"/>
	</target>

	<target name="t02_switch_case">
		<root class="T02_SWITCH_CASE" feature="make"/>
		<setting name="console_application" value="true"/>
		<capability>
			<concurrency use="none"/>
		</capability>
		<library name="base" location="$ISE_LIBRARY\library\base\base.ecf"/>
		<library name="time" location="$ISE_LIBRARY\library\time\time.ecf"/>
		<cluster name="tasks" location=".\"/>
	</target>

	<target name="t03_func_sum">
		<root class="T03_FUNC_SUM" feature="make"/>
		<setting name="console_application" value="true"/>
