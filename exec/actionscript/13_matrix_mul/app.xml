<?xml version="1.0" encoding="utf-8" ?>
<!-- The one shared descriptor for all 15 ActionScript tasks, beside the .as files the
     way GDScript's project.godot is. Every task compiles to prog.swf and packages to
     out\prog.exe, so one descriptor with <content>prog.swf</content> serves all of
     them; only the .as filename differs between tasks.
     <visible>false</visible> is what keeps the app from opening a window: AIR renders
     the main Sprite's window otherwise, and for a cmdline-target bundle there is
     nothing to show. -->
<application xmlns="http://ns.adobe.com/air/application/51.4">
    <id>stupidspeed.actionscript</id>
    <filename>prog</filename>
    <name>prog</name>
    <versionNumber>1.0.0</versionNumber>
    <initialWindow>
        <content>prog.swf</content>
        <visible>false</visible>
    </initialWindow>
</application>
