(* task 10 pi — expected output: 4470 *)
(* build: Compiler.exe _10_pi.ob07 win64con -out prog.exe    run: prog.exe *)
(* note: Oberon-07 has no big integers, so Gibbons' unbounded spigot runs on hand-written *)
(*       sign-magnitude big integers: little-endian limbs, base 10^9, held in a record with *)
(*       an INTEGER array field. INTEGER is 64 bit here, so limb * small + carry is exact. *)
(*       Only add, subtract, multiply by a small integer and a quotient are implemented; the *)
(*       spigot only ever asks for a small quotient, so counting how many times b fits into a *)
(*       finds it by repeated subtraction. The same algorithm as the C row, operation for *)
(*       operation. Only the sum of the digits is printed. *)
(* note: in this dialect RETURN is not a statement: a function body is a statement sequence *)
(*       followed by exactly one RETURN expression, so each big-integer function below ends *)
(*       with a single RETURN and puts its result in a local variable. *)
(* note: the spigot state reaches roughly 145000 decimal digits by the 1000th digit, so the *)
(*       limb arrays are sized well past that; 32768 limbs is 256 KB per big number. *)
(* note: Compiler.exe is C:\stupidspeed\tools\oberon07\oberon-07-compiler-master\Compiler.exe, *)
(*       which has no optimisation switch; the build line above is the whole story. *)
(* note: the line is ended with Out.Char(0AX) and not Out.Ln. Out.Ln prints CR LF, and msvcrt *)
(*       text mode then translates that LF a second time, so the pipe receives CR CR LF; a *)
(*       lone LF from Out.Char goes through the same translation as one CR LF, the normal *)
(*       Windows line ending. Nothing else in the output is affected. *)

(* timing: GetSystemTimePreciseAsFileTime is the Windows 100-nanosecond clock, declared
   here with the same [windows-, "kernel32.dll", ""] foreign form the shipped library
   uses for its own kernel32 imports (QueryPerformanceCounter is not importable from
   this toolchain's win64con link, which is why it is not used); TIME_MS is written to
   stderr with WriteFile on GetStdHandle(-12), so stdout is unchanged. *)
MODULE _10_pi;
IMPORT Out, SYSTEM;

CONST
  Base   = 1000000000;
  Limbs  = 32768;
  Digits = 1000;

TYPE
  Big = RECORD
    n:    INTEGER;                 (* limb count, no leading zero limbs *)
    neg:  BOOLEAN;
    limb: ARRAY Limbs OF INTEGER
  END;

VAR
  ssT0: INTEGER;
  q, r, t, u, v, w: Big;
  k, l, n, next: INTEGER;
  sum: INTEGER;
  produced: INTEGER;

PROCEDURE Trim(VAR x: Big);
BEGIN
  WHILE (x.n > 0) & (x.limb[x.n - 1] = 0) DO DEC(x.n) END;
  IF x.n = 0 THEN x.neg := FALSE END
END Trim;

PROCEDURE Set(VAR x: Big; v: INTEGER);
BEGIN
  x.n := 0; x.neg := FALSE;
  WHILE v > 0 DO
    x.limb[x.n] := v MOD Base;
    INC(x.n);
    v := v DIV Base
  END
END Set;

PROCEDURE CopyLimbs(VAR dst, src: Big);
VAR i: INTEGER;
BEGIN
  i := 0;
  WHILE i < src.n DO dst.limb[i] := src.limb[i]; INC(i) END;
  dst.n := src.n; dst.neg := src.neg
END CopyLimbs;

PROCEDURE CmpMag(VAR a, b: Big): INTEGER;
VAR i, res: INTEGER;
BEGIN
  IF a.n # b.n THEN
    IF a.n < b.n THEN res := -1 ELSE res := 1 END
  ELSE
    res := 0;
    i := a.n;
    WHILE (res = 0) & (i > 0) DO
      DEC(i);
      IF a.limb[i] # b.limb[i] THEN
        IF a.limb[i] < b.limb[i] THEN res := -1 ELSE res := 1 END
      END
    END
  END
RETURN res
END CmpMag;

PROCEDURE Cmp(VAR a, b: Big): INTEGER;
VAR c, res: INTEGER;
BEGIN
  IF a.neg # b.neg THEN
    IF a.neg THEN res := -1 ELSE res := 1 END
  ELSE
    c := CmpMag(a, b);
    IF a.neg THEN res := -c ELSE res := c END
  END
RETURN res
END Cmp;

PROCEDURE AddMag(VAR res: Big; VAR a, b: Big);
VAR i, len: INTEGER; carry, s: INTEGER;
BEGIN
  IF a.n > b.n THEN len := a.n ELSE len := b.n END;
  carry := 0;
  FOR i := 0 TO len - 1 DO
    s := carry;
    IF i < a.n THEN s := s + a.limb[i] END;
    IF i < b.n THEN s := s + b.limb[i] END;
    IF s >= Base THEN s := s - Base; carry := 1 ELSE carry := 0 END;
    res.limb[i] := s
  END;
  res.limb[len] := carry;
  IF carry # 0 THEN res.n := len + 1 ELSE res.n := len END;
  res.neg := FALSE
END AddMag;

PROCEDURE SubMag(VAR res: Big; VAR a, b: Big);   (* requires a >= b >= 0 *)
VAR i: INTEGER; borrow, bi: INTEGER;
BEGIN
  borrow := 0;
  FOR i := 0 TO a.n - 1 DO
    bi := borrow;
    IF i < b.n THEN bi := bi + b.limb[i] END;
    IF a.limb[i] >= bi THEN
      res.limb[i] := a.limb[i] - bi; borrow := 0
    ELSE
      res.limb[i] := a.limb[i] + Base - bi; borrow := 1
    END
  END;
  res.n := a.n; res.neg := FALSE;
  Trim(res)
END SubMag;

PROCEDURE Add(VAR res: Big; VAR a, b: Big);
VAR an, bn: BOOLEAN;
BEGIN
  an := a.neg; bn := b.neg;
  IF an = bn THEN
    AddMag(res, a, b); res.neg := an
  ELSIF CmpMag(a, b) >= 0 THEN
    SubMag(res, a, b); res.neg := an
  ELSE
    SubMag(res, b, a); res.neg := bn
  END;
  Trim(res)
END Add;

PROCEDURE Sub(VAR res: Big; VAR a, b: Big);      (* res = a - b *)
VAR an: BOOLEAN;
BEGIN
  an := a.neg;
  IF a.neg # b.neg THEN
    AddMag(res, a, b); res.neg := an
  ELSIF CmpMag(a, b) >= 0 THEN
    SubMag(res, a, b); res.neg := an
  ELSE
    SubMag(res, b, a); res.neg := ~an
  END;
  Trim(res)
END Sub;

PROCEDURE MulSmall(VAR res: Big; VAR a: Big; m: INTEGER);
VAR i, len: INTEGER; carry, p: INTEGER;
BEGIN
  IF (m = 0) OR (a.n = 0) THEN
    res.n := 0; res.neg := FALSE
  ELSE
    carry := 0;
    FOR i := 0 TO a.n - 1 DO
      p := a.limb[i] * m + carry;
      res.limb[i] := p MOD Base;
      carry := p DIV Base
    END;
    len := a.n;
    WHILE carry > 0 DO
      res.limb[len] := carry MOD Base;
      INC(len);
      carry := carry DIV Base
    END;
    res.n := len; res.neg := a.neg;
    Trim(res)
  END
END MulSmall;

(* floor(a / b) for a >= 0 and b > 0. The spigot only ever asks for a small quotient, so *)
(* counting how many times b fits into a is enough. *)
PROCEDURE Quot(VAR a, b: Big; VAR work: Big): INTEGER;
VAR q: INTEGER;
BEGIN
  q := 0;
  IF ~(a.neg OR b.neg OR (b.n = 0)) THEN
    CopyLimbs(work, b);
    WHILE Cmp(a, work) >= 0 DO
      INC(q);
      AddMag(work, work, b)
    END
  END
RETURN q
END Quot;

PROCEDURE [windows-, "kernel32.dll", ""] GetStdHandle (nStdHandle: INTEGER): INTEGER;
PROCEDURE [windows-, "kernel32.dll", ""] WriteFile (hFile, Buffer, nBytes, written, overlapped: INTEGER): INTEGER;
PROCEDURE [windows-, "kernel32.dll", ""] GetSystemTimePreciseAsFileTime (t: INTEGER): INTEGER;

PROCEDURE ssNow (): INTEGER;
  VAR a: ARRAY 1 OF INTEGER;
      r: INTEGER;
BEGIN
  a[0] := 0;
  r := GetSystemTimePreciseAsFileTime(SYSTEM.ADR(a));
RETURN a[0] DIV 10000   (* the FILETIME tick is 100 ns, so 10 000 of them make a millisecond *)
END ssNow;

PROCEDURE ssReport (t0: INTEGER);
  VAR ms, n, i, h, r: INTEGER;
      buf: ARRAY 32 OF CHAR;
      d: ARRAY 32 OF CHAR;
BEGIN
  ms := ssNow() - t0;
  buf[0] := "T"; buf[1] := "I"; buf[2] := "M"; buf[3] := "E";
  buf[4] := "_"; buf[5] := "M"; buf[6] := "S"; buf[7] := "=";
  n := 0;
  IF ms <= 0 THEN
    d[0] := "0"; n := 1
  ELSE
    WHILE ms > 0 DO
      d[n] := CHR(ms MOD 10 + ORD("0")); ms := ms DIV 10; INC(n)
    END
  END;
  i := 0;
  WHILE i < n DO
    buf[8 + i] := d[n - 1 - i]; INC(i)
  END;
  buf[8 + n] := 0AX;
  h := GetStdHandle(-12);   (* STD_ERROR_HANDLE *)
  r := WriteFile(h, SYSTEM.ADR(buf), 9 + n, 0, 0)
END ssReport;

BEGIN
  ssT0 := ssNow();
  Set(q, 1);
  Set(r, 0);
  Set(t, 1);

  k := 1; l := 3; n := 3;
  sum := 0; produced := 0;

  WHILE produced < Digits DO
    MulSmall(u, q, 4);
    Add(u, u, r);                    (* u = 4q + r *)
    MulSmall(v, t, n + 1);           (* v = (n + 1)t *)

    IF Cmp(u, v) < 0 THEN
      (* the digit n is settled *)
      sum := sum + n;
      INC(produced);

      MulSmall(u, q, 3);
      Add(u, u, r);
      MulSmall(u, u, 10);            (* u = 10(3q + r) *)
      next := Quot(u, t, w) - 10 * n;

      MulSmall(v, t, n);             (* v = n t *)
      Sub(v, r, v);                  (* v = r - n t *)
      MulSmall(r, v, 10);            (* r = 10(r - n t) *)
      MulSmall(q, q, 10);            (* q = 10q, t is unchanged *)

      n := next
    ELSE
      (* not settled yet: widen the state by one more term *)
      MulSmall(u, q, 7 * k + 2);
      MulSmall(v, r, l);
      Add(u, u, v);                  (* u = q(7k + 2) + r l *)
      MulSmall(v, t, l);             (* v = t l *)
      next := Quot(u, v, w);

      MulSmall(u, q, 2);
      Add(u, u, r);
      MulSmall(u, u, l);             (* u = (2q + r) l *)
      CopyLimbs(r, u);
      MulSmall(q, q, k);
      MulSmall(t, t, l);

      INC(k);
      l := l + 2;
      n := next
    END
  END;

  ssReport(ssT0);
  Out.Int(sum, 1); Out.Char(0AX)
END _10_pi.
