# task 01 branches — expected output: 33333334 13333333 7619048 45714285
# build: s7c -O2 prog.sd7    run: ./prog
# note: s7c has no code generator of its own: it translates the program to one C file and
#       calls the C compiler that was configured when Seed7 was built, so gcc must be on
#       PATH whenever s7c runs. The executable is named after the source file and is
#       written beside it, which is why the build line compiles a scratch copy called
#       prog.sd7. The executable needs no Seed7 runtime at run time.
# note: -O2 is not optional. Without -O s7c passes no optimisation flag to the C compiler.

$ include "seed7_05.s7i";
  include "time.s7i";

(* timing: GET_TIME (TIM_NOW) is Seed7's clock, giving the local time of day down to
   the microsecond; TIME_MS goes to stderr with writeln(STD_ERR, ...), and stdout is
   unchanged. Instrumented by inspection: Seed7 is not installed on this machine, so
   this row's timing is unverified. *)
const func integer: ssNowMs is func
  result
    var integer: ms is 0;
  local
    var integer: year is 0;
    var integer: month is 0;
    var integer: day is 0;
    var integer: hour is 0;
    var integer: minute is 0;
    var integer: second is 0;
    var integer: micro_second is 0;
    var integer: timeZone is 0;
    var boolean: daylightSavingTime is FALSE;
  begin
    GET_TIME(year, month, day, hour, minute, second, micro_second, timeZone, daylightSavingTime);
    ms := ((hour * 60 + minute) * 60 + second) * 1000 + micro_second div 1000;
  end func;

const proc: ssReport (in integer: t0) is func
  local
    var integer: ms is 0;
  begin
    ms := ssNowMs - t0;
    writeln(STD_ERR, "TIME_MS=" <& str(ms));
  end func;

const proc: main is func
  local
    var integer: ssT0 is 0;
    var integer: a is 0;
    var integer: b is 0;
    var integer: c is 0;
    var integer: d is 0;
    var integer: i is 0;
  begin
    ssT0 := ssNowMs;
    for i range 0 to 99999999 do
      if i mod 3 = 0 then
        a +:= 1;
      elsif i mod 5 = 0 then
        b +:= 1;
      elsif i mod 7 = 0 then
        c +:= 1;
      else
        d +:= 1;
      end if;
    end for;

    ssReport(ssT0);
    writeln(a <& " " <& b <& " " <& c <& " " <& d);
  end func;
