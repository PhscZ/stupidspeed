# task 14 file_read — expected output: 2389704704
# build: s7c -O2 prog.sd7    run: ./prog
# note: data.bin is read from the working directory in binary mode ("r", not "rt") with the
#       same 1 MiB chunking the C row uses, and every byte is added in. There is no text
#       mode deviation here.
# note: Seed7 chars are UTF-32, so each byte read becomes a char and ord() gives the byte
#       value back; the file contains bytes 0..255, so the values are the same.
# note: the total is reduced with 'mod 4294967296' at the end, as in the other rows.

$ include "seed7_05.s7i";
  include "time.s7i";

(* timing: GET_TIME (TIM_NOW) is Seed7's clock, giving the local time of day down to
   the microsecond; TIME_MS goes to stderr with writeln(STD_ERR, ...), and stdout is
   unchanged. Instrumented by inspection: Seed7 is not installed on this machine, so
   this row's timing is unverified. *)
const func integer: ssNowMs is func
  result
    var integer: ms is 0;
  local
    var integer: year is 0;
    var integer: month is 0;
    var integer: day is 0;
    var integer: hour is 0;
    var integer: minute is 0;
    var integer: second is 0;
    var integer: micro_second is 0;
    var integer: timeZone is 0;
    var boolean: daylightSavingTime is FALSE;
  begin
    GET_TIME(year, month, day, hour, minute, second, micro_second, timeZone, daylightSavingTime);
    ms := ((hour * 60 + minute) * 60 + second) * 1000 + micro_second div 1000;
  end func;

const proc: ssReport (in integer: t0) is func
  local
    var integer: ms is 0;
  begin
    ms := ssNowMs - t0;
    writeln(STD_ERR, "TIME_MS=" <& str(ms));
  end func;

const proc: main is func
  local
    var integer: ssT0 is 0;
    var file: f is STD_NULL;
    var string: chunk is "";
    var integer: total is 0;
    var integer: i is 0;
  begin
    ssT0 := ssNowMs;
    f := open("data.bin", "r");
    chunk := gets(f, 1048576);
    while length(chunk) > 0 do
      for i range 1 to length(chunk) do
        total +:= ord(chunk[i]);
      end for;
      chunk := gets(f, 1048576);
    end while;
    close(f);

    ssReport(ssT0);
    writeln(total mod 4294967296);
  end func;
